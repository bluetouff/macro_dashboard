# Copier ce fichier en `.env` et y mettre ta vraie clé FRED.
# Le fichier `.env` est ignoré par git (voir .gitignore).
# Obtenir une clé : https://fredaccount.stlouisfed.org/apikeys

FRED_API_KEY=your_fred_api_key_here

# Production uniquement : SHA Git complet du calculateur déployé.
MACRO_DASHBOARD_SOURCE_SHA=0000000000000000000000000000000000000000
